struct Accumulator {
    total: u32,
    samples: u32,
}

fn append(inout state: Accumulator, value: u32) {
    state.total = state.total + value;
    state.samples = state.samples + 1u;
}

@stage(compute(8, 1, 1))
fn mutable_values(
    #[binding(set = 0, binding = 0)] output: RWBuffer<uvec2>,
    #[builtin(global_invocation_id)] gid: uvec3,
) {
    let mut state = Accumulator { total: 0u, samples: 0u };
    append(state, gid.x);
    append(state, 3u);
    let mut values: [u32; 2] = [state.total, state.samples];
    values[0u] = values[0u] + values[1u];
    output[gid.x] = uvec2(values[0u], values[1u]);
}
