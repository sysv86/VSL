// Request KHR opacity micromap traversal and fetch committed triangle positions.
#[cap(ray_query, omm_khr, position_fetch)]
@stage(compute(8, 8, 1))
fn micromap_positions(
    #[binding(set = 0, binding = 0)] scene: AccelerationStructure,
    #[binding(set = 0, binding = 1)] result: RWImage2D<rgba16f>,
    #[builtin(global_invocation_id)] pixel: uvec3,
) {
    let mut query: RayQuery;
    let origin = vec3(f32(pixel.x) * 0.01, f32(pixel.y) * 0.01, -2.0);
    query.initialize(scene, 0u, 255u, origin, 0.01, vec3(0.0, 0.0, 1.0), 64.0);
    while query.proceed() {
        if query.candidate_type() == 0u {
            query.confirm_intersection();
        }
    }
    let mut color = vec4(0.0);
    if query.committed_type() == 1u {
        let vertices: [vec3; 3] = query.committed_triangle_vertex_positions();
        let normal = normalize(cross(vertices[1u] - vertices[0u], vertices[2u] - vertices[0u]));
        color = vec4(normal * 0.5 + vec3(0.5), 1.0);
    }
    result.store(ivec2(pixel.xy), color);
}
