// Visualize triangle barycentrics with one ray per launch coordinate.
@raygen
fn primary(
    #[binding(set = 0, binding = 0)] scene: AccelerationStructure,
    #[binding(set = 0, binding = 1)] result: RWImage2D<rgba16f>,
    #[ray_payload(0)] inout color: vec4,
    #[builtin(launch_id)] pixel: uvec3,
) {
    color = vec4(0.0);
    let origin = vec3(f32(pixel.x) * 0.01, f32(pixel.y) * 0.01, -2.0);
    trace_ray(scene, 0u, 255u, 0u, 0u, 0u, origin, 0.01, vec3(0.0, 0.0, 1.0), 64.0, color);
    result.store(ivec2(pixel.xy), color);
}

@closest_hit
fn triangle_color(
    #[incoming_ray_payload(0)] inout color: vec4,
    #[hit_attribute] uv: vec2,
) {
    color = vec4(1.0 - uv.x - uv.y, uv.x, uv.y, 1.0);
}

@miss
fn background(#[incoming_ray_payload(0)] inout color: vec4) {
    color = vec4(0.04, 0.08, 0.16, 1.0);
}
